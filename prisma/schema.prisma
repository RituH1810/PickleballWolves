generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  ORGANIZER
  ADMIN
}

enum Hand {
  LEFT
  RIGHT
  AMBIDEXTROUS
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum MembershipRole {
  MEMBER
  ORGANIZER
}

enum MembershipStatus {
  ACTIVE
  PENDING
  INVITED
  DECLINED
}

enum EventFormat {
  SINGLES
  DOUBLES
  MIXED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RsvpStatus {
  GOING
  WAITLISTED
  CANCELLED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  FORFEIT
  DISPUTED
}

enum Side {
  A
  B
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum TournamentSkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TournamentEventType {
  SINGLES
  DOUBLES
  MIXED
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  TEAMS_LOCKED
  LIVE
  COMPLETED
  CANCELLED
}

enum TeamFormationMethod {
  MANUAL
  AUTO_RANDOM
  AUTO_BALANCED
}

enum GroupAssignmentMethod {
  MANUAL
  RANDOM
  SEEDED
}

enum RegistrationMode {
  ROSTER
  OPEN
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  photoUrl        String?
  phone           String?
  role            UserRole     @default(PLAYER)
  skillRating     Decimal      @db.Decimal(3, 1)
  preferredHand   Hand         @default(RIGHT)
  homeCourt       String?
  gender          Gender?
  // Secret for the player's private calendar feed URL (/api/calendar/feed/<token>); null until
  // they first open it, and replaced when they reset the link.
  calendarToken   String?      @unique
  // A name-only player an organizer added to a round robin: no login, never notified, emailed, or
  // listed (leaderboards, search, player counts). Their matches count like anyone else's.
  isGuest         Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  approvedMemberships Membership[] @relation("MembershipApprovedBy")
  createdGroups   Group[]      @relation("GroupCreator")
  createdEvents   Event[]      @relation("EventCreator")
  rsvps           RSVP[]
  roundRobinRsvps RoundRobinRSVP[]
  enteredMatches  Match[]      @relation("MatchEnteredBy")
  confirmedMatches Match[]     @relation("MatchConfirmedBy")
  matchPlayers    MatchPlayer[]
  auditLogs       AuditLog[]
  createdTournaments        Tournament[]            @relation("TournamentCreator")
  tournamentEntries         TournamentEntrant[]
  tournamentTeamMemberships TournamentTeamMember[]
  createdLeagues            League[]                @relation("LeagueCreatedBy")
  leagueRegistrations       LeagueRegistration[]
  leagueTeamMemberships     LeagueTeamMember[]
}

model Group {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String
  location    String
  logoUrl     String?
  visibility  GroupVisibility @default(PUBLIC)
  createdById String
  createdBy   User            @relation("GroupCreator", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  memberships Membership[]
  events      Event[]
  invites     GroupInvite[]
  announcements Announcement[]
  roundRobins RoundRobin[]
  leagues     League[]
  recurringSchedules RecurringSchedule[]
}

model Membership {
  id           String           @id @default(cuid())
  groupId      String
  userId       String
  role         MembershipRole   @default(MEMBER)
  status       MembershipStatus @default(PENDING)
  joinedAt     DateTime?
  approvedById String?
  group        Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy   User?            @relation("MembershipApprovedBy", fields: [approvedById], references: [id])
  @@unique([groupId, userId])
}

model GroupInvite {
  id            String    @id @default(cuid())
  groupId       String
  invitedEmail  String
  invitedUserId  String?
  token         String    @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdById   String
  group         Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  groupId   String
  authorId  String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Event {
  id             String      @id @default(cuid())
  groupId        String?
  createdById    String
  title          String
  description    String?
  startsAt       DateTime
  endsAt         DateTime?
  location       String
  courtCount     Int         @default(1)
  playerCap      Int
  minSkillRating Decimal?    @db.Decimal(3, 1)
  maxSkillRating Decimal?    @db.Decimal(3, 1)
  format         EventFormat @default(DOUBLES)
  costCents      Int         @default(0)
  recurrenceRule String?
  status         EventStatus @default(DRAFT)
  reminderSentAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  group          Group?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy      User        @relation("EventCreator", fields: [createdById], references: [id])
  rsvps          RSVP[]
  matches        Match[]
}

model RSVP {
  id              String     @id @default(cuid())
  eventId         String
  userId          String
  status          RsvpStatus @default(WAITLISTED)
  waitlistPosition Int?
  respondedAt     DateTime   @default(now())
  event           Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId])
}

model RoundRobin {
  id            String   @id @default(cuid())
  eventId       String?
  groupId       String?
  createdById   String
  name          String
  format        String
  partnerFormat String   @default("ROTATE")
  playFormat    String   @default("DOUBLES")
  courtCount    Int
  roundCount    Int
  pointsToWin   Int
  winBy         Int
  skillBalanced Boolean  @default(false)
  status        String   @default("SETUP")
  scheduledAt   DateTime?
  reminderSentAt DateTime?
  createdAt     DateTime @default(now())
  completedAt   DateTime?
  recurringScheduleId String?
  group         Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  recurringSchedule RecurringSchedule? @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)
  rounds        Round[]
  matches       Match[]
  rsvps         RoundRobinRSVP[]
}

// A group's standing weekly game ("every Mon & Thu at 6:30pm"). The cron job turns each upcoming
// occurrence into a regular group RoundRobin a week ahead. generatedThrough marks how far it has
// already gone, so a game an organizer deletes isn't recreated.
model RecurringSchedule {
  id               String       @id @default(cuid())
  groupId          String
  createdById      String
  daysOfWeek       Int[]        // 0 = Sunday ... 6 = Saturday, in timeZone
  timeOfDay        String       // "18:30", wall-clock time in timeZone
  timeZone         String       // IANA name, e.g. "America/New_York"
  playFormat       String       @default("DOUBLES")
  partnerFormat    String       @default("ROTATE")
  courtCount       Int          @default(1)
  pointsToWin      Int          @default(11)
  winBy            Int          @default(1)
  generatedThrough DateTime
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  group            Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roundRobins      RoundRobin[]
  alwaysIn         RecurringScheduleMember[]
  @@index([groupId])
}

// "Always in": a member who's joined automatically to every game this schedule creates.
model RecurringScheduleMember {
  id         String            @id @default(cuid())
  scheduleId String
  userId     String
  createdAt  DateTime          @default(now())
  schedule   RecurringSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  @@unique([scheduleId, userId])
}

enum RoundRobinRsvpStatus {
  JOINED
  DECLINED
}

model RoundRobinRSVP {
  id           String               @id @default(cuid())
  roundRobinId String
  userId       String
  status       RoundRobinRsvpStatus
  respondedAt  DateTime             @default(now())
  roundRobin   RoundRobin           @relation(fields: [roundRobinId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([roundRobinId, userId])
}

model Round {
  id           String     @id @default(cuid())
  roundRobinId String
  roundNumber  Int
  status       String     @default("PENDING")
  roundRobin   RoundRobin @relation(fields: [roundRobinId], references: [id], onDelete: Cascade)
  matches      Match[]
  @@unique([roundRobinId, roundNumber])
}

model Match {
  id             String      @id @default(cuid())
  eventId        String?
  roundRobinId   String?
  roundId        String?
  tournamentGroupId String?
  tournamentTeamAId String?
  tournamentTeamBId String?
  leagueDivisionId String?
  leagueTeamAId  String?
  leagueTeamBId  String?
  courtNumber    Int?
  scheduledAt    DateTime?
  status         MatchStatus @default(SCHEDULED)
  winnerSide     Side?
  enteredById    String?
  confirmedById  String?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  event          Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  roundRobin     RoundRobin? @relation(fields: [roundRobinId], references: [id], onDelete: SetNull)
  round          Round?      @relation(fields: [roundId], references: [id], onDelete: SetNull)
  tournamentGroup TournamentGroup? @relation(fields: [tournamentGroupId], references: [id], onDelete: SetNull)
  tournamentTeamA TournamentTeam?  @relation("MatchTournamentTeamA", fields: [tournamentTeamAId], references: [id], onDelete: SetNull)
  tournamentTeamB TournamentTeam?  @relation("MatchTournamentTeamB", fields: [tournamentTeamBId], references: [id], onDelete: SetNull)
  leagueDivision  Division?   @relation("MatchLeagueDivision", fields: [leagueDivisionId], references: [id], onDelete: SetNull)
  leagueTeamA    LeagueTeam? @relation("MatchLeagueTeamA", fields: [leagueTeamAId], references: [id], onDelete: SetNull)
  leagueTeamB    LeagueTeam? @relation("MatchLeagueTeamB", fields: [leagueTeamBId], references: [id], onDelete: SetNull)
  enteredBy      User?       @relation("MatchEnteredBy", fields: [enteredById], references: [id])
  confirmedBy    User?       @relation("MatchConfirmedBy", fields: [confirmedById], references: [id])
  players        MatchPlayer[]
  scores         GameScore[]
  auditLogs      AuditLog[]
  bracketMatch   TournamentBracketMatch?
  leagueMatch    LeagueMatch?
}

model MatchPlayer {
  id       String @id @default(cuid())
  matchId  String
  userId   String
  side     Side
  position Int?
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([matchId, userId])
}

model GameScore {
  id          String   @id @default(cuid())
  matchId     String
  gameNumber  Int
  sideAScore  Int
  sideBScore  Int
  enteredById String
  confirmedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  @@unique([matchId, gameNumber])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  entityType String
  entityId   String
  action     String
  beforeData Json?
  afterData  Json?
  matchId    String?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])
  match      Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  @@index([entityType, entityId])
}

model ScoreDispute {
  id             String   @id @default(cuid())
  matchId        String
  openedById     String
  reason         String
  proposedScores Json?
  status         String   @default("OPEN")
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
}

model League {
  id          String   @id @default(cuid())
  groupId     String?
  name        String
  description String?
  format      String
  createdById String
  createdAt   DateTime @default(now())
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy   User     @relation("LeagueCreatedBy", fields: [createdById], references: [id])
  seasons     Season[]
}

model Season {
  id                   String   @id @default(cuid())
  leagueId             String
  name                 String
  startDate            DateTime
  endDate              DateTime
  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  status               String   @default("UPCOMING")
  playoffsEnabled      Boolean  @default(false)
  league               League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  divisions            Division[]
  leagueMatches        LeagueMatch[]
}

model Division {
  id             String   @id @default(cuid())
  seasonId       String
  name           String
  minSkillRating Decimal? @db.Decimal(3, 1)
  maxSkillRating Decimal? @db.Decimal(3, 1)
  season         Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  registrations  LeagueRegistration[]
  teams          LeagueTeam[]
  matches        Match[]  @relation("MatchLeagueDivision")
  leagueMatches  LeagueMatch[]
}

model LeagueRegistration {
  id         String @id @default(cuid())
  divisionId String
  userId     String
  status     String @default("REGISTERED")
  createdAt  DateTime @default(now())
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([divisionId, userId])
}

model LeagueTeam {
  id         String @id @default(cuid())
  divisionId String
  seed       Int?
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  members    LeagueTeamMember[]
  matchesA   Match[] @relation("MatchLeagueTeamA")
  matchesB   Match[] @relation("MatchLeagueTeamB")
}

model LeagueTeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  team   LeagueTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([teamId, userId])
}

model LeagueMatch {
  id         String   @id @default(cuid())
  seasonId   String
  divisionId String
  matchId    String   @unique
  weekNumber Int
  scheduledAt DateTime
  status     String   @default("SCHEDULED")
  season     Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Ladder {
  id                   String   @id @default(cuid())
  groupId              String?
  name                 String
  type                 String
  challengeRange       Int      @default(3)
  responseDeadlineHours Int     @default(48)
  inactivityPenalty    Int      @default(0)
  createdById          String
  active               Boolean  @default(true)
}

model LadderPosition {
  id           String   @id @default(cuid())
  ladderId     String
  userId       String
  position     Int
  rating       Decimal  @db.Decimal(6, 2)
  wins         Int      @default(0)
  losses       Int      @default(0)
  lastActiveAt DateTime?
  updatedAt    DateTime @updatedAt
  @@unique([ladderId, userId])
}

model Challenge {
  id            String   @id @default(cuid())
  ladderId      String
  challengerId  String
  challengedId  String
  createdAt     DateTime @default(now())
  deadlineAt    DateTime
  status        String   @default("PENDING")
  matchId       String?
}

model RatingHistory {
  id          String   @id @default(cuid())
  userId      String
  ladderId    String?
  matchId     String?
  ratingBefore Decimal @db.Decimal(6, 2)
  ratingAfter  Decimal @db.Decimal(6, 2)
  ratingDelta  Decimal @db.Decimal(6, 2)
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
}

model NotificationPreference {
  id                String  @id @default(cuid())
  userId            String  @unique
  emailReminders    Boolean @default(true)
  inAppReminders    Boolean @default(true)
  scoreDisputeAlerts Boolean @default(true)
  challengeAlerts   Boolean @default(true)
  weeklyDigest      Boolean @default(true)
  achievementAlerts Boolean @default(true)
  gameChatAlerts    Boolean @default(true)
}

// A phone/browser that agreed to receive push notifications (Web Push). One player can have several.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  @@index([userId])
}

// "Running 10 min late" -- a short message thread on one round robin.
model RoundRobinMessage {
  id           String   @id @default(cuid())
  roundRobinId String
  authorId     String
  body         String
  createdAt    DateTime @default(now())
  @@index([roundRobinId, createdAt])
}

// An organizer asks the group which times work before scheduling; members vote on options and the
// organizer turns the winner into a round robin (scheduledRoundRobinId).
model AvailabilityPoll {
  id                    String               @id @default(cuid())
  groupId               String
  createdById           String
  question              String
  timeZone              String
  status                String               @default("OPEN") // OPEN | SCHEDULED | CLOSED
  scheduledRoundRobinId String?
  createdAt             DateTime             @default(now())
  options               AvailabilityOption[]
  @@index([groupId, createdAt])
}

model AvailabilityOption {
  id       String             @id @default(cuid())
  pollId   String
  startsAt DateTime
  poll     AvailabilityPoll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes    AvailabilityVote[]
}

model AvailabilityVote {
  id       String             @id @default(cuid())
  optionId String
  userId   String
  option   AvailabilityOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  @@unique([optionId, userId])
}

// Badges a player has already been told about, so "Achievement unlocked!" fires once per badge.
// Badges themselves are still computed from match history (src/lib/achievements.ts).
model AchievementUnlock {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime
  createdAt     DateTime @default(now())
  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

// A group's Player of the Week for the Monday-Sunday week starting at weekStart (local midnight),
// chosen and announced every Monday. Ties share the award (one row each).
model PlayerOfTheWeek {
  id           String   @id @default(cuid())
  groupId      String
  weekStart    DateTime
  userId       String
  matches      Int
  wins         Int
  losses       Int
  avgPointDiff Float
  createdAt    DateTime @default(now())
  @@unique([groupId, weekStart, userId])
  @@index([userId])
}

// A group's awards for one calendar month (e.g. "2026-10"), computed on the 1st of the next month.
model MonthlyAward {
  id        String   @id @default(cuid())
  groupId   String
  month     String
  award     String   // MOST_IMPROVED | IRON_WOLF | BEST_PARTNERSHIP
  userId    String
  partnerId String?
  value     Float
  detail    String
  createdAt DateTime @default(now())
  @@unique([groupId, month, award, userId])
  @@index([userId])
}

model Tournament {
  id                    String                 @id @default(cuid())
  createdById           String
  name                  String
  description           String?
  location              String
  courtCount            Int                    @default(2)
  startDate             DateTime
  endDate               DateTime?
  skillLevel            TournamentSkillLevel
  eventType             TournamentEventType
  groupCount            Int                    @default(1)
  maxTeamsPerGroup      Int                    @default(4)
  teamFormationMethod   TeamFormationMethod    @default(AUTO_RANDOM)
  groupAssignmentMethod GroupAssignmentMethod  @default(RANDOM)
  registrationMode      RegistrationMode       @default(ROSTER)
  registrationDeadline  DateTime?
  pointsToWin           Int                    @default(11)
  winBy                 Int                    @default(1)
  status                TournamentStatus       @default(DRAFT)
  // Organizer branding and the public page (/t/<publicSlug>), shown only while isPublic is on.
  isPublic              Boolean                @default(false)
  publicSlug            String?                @unique
  brandColor            String?
  presentedBy           String?
  logoAssetId           String?
  bannerAssetId         String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  createdBy             User                   @relation("TournamentCreator", fields: [createdById], references: [id])
  entrants              TournamentEntrant[]
  teams                 TournamentTeam[]
  pools                 TournamentGroup[]
  bracketMatches        TournamentBracketMatch[]
  assets                TournamentAsset[]
  sponsors              TournamentSponsor[]
}

// Branding images (logo, banner, sponsor logos), stored resized and served from /api/t-assets/<id>.
model TournamentAsset {
  id           String     @id @default(cuid())
  tournamentId String
  kind         String     // LOGO | BANNER | SPONSOR
  contentType  String
  data         Bytes
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  @@index([tournamentId])
}

model TournamentSponsor {
  id           String     @id @default(cuid())
  tournamentId String
  name         String
  url          String?
  logoAssetId  String?
  position     Int        @default(0)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  @@index([tournamentId])
}

model TournamentEntrant {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  status       String     @default("REGISTERED")
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tournamentId, userId])
}

model TournamentTeam {
  id           String     @id @default(cuid())
  tournamentId String
  poolId       String?
  seed         Int?
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  pool         TournamentGroup? @relation(fields: [poolId], references: [id], onDelete: SetNull)
  members      TournamentTeamMember[]
  matchesAsTeamA Match[] @relation("MatchTournamentTeamA")
  matchesAsTeamB Match[] @relation("MatchTournamentTeamB")
  bracketMatchesAsTeamA TournamentBracketMatch[] @relation("BracketTeamA")
  bracketMatchesAsTeamB TournamentBracketMatch[] @relation("BracketTeamB")
}

model TournamentTeamMember {
  id     String         @id @default(cuid())
  teamId String
  userId String
  team   TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([teamId, userId])
}

model TournamentGroup {
  id           String     @id @default(cuid())
  tournamentId String
  name         String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teams        TournamentTeam[]
  matches      Match[]
}

// A single-elimination bracket slot. Round 1 holds real team pairings (byes are resolved at
// generation time and never get a row here); later rounds start empty and fill in as earlier
// matches are scored, via nextMatchId/nextSlot pointing at the match the winner advances to.
model TournamentBracketMatch {
  id           String     @id @default(cuid())
  tournamentId String
  round        Int
  position     Int
  teamAId      String?
  teamBId      String?
  matchId      String?    @unique
  nextMatchId  String?
  nextSlot     String?
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamA        TournamentTeam? @relation("BracketTeamA", fields: [teamAId], references: [id], onDelete: SetNull)
  teamB        TournamentTeam? @relation("BracketTeamB", fields: [teamBId], references: [id], onDelete: SetNull)
  match        Match?     @relation(fields: [matchId], references: [id], onDelete: SetNull)
  nextMatch    TournamentBracketMatch? @relation("BracketAdvancement", fields: [nextMatchId], references: [id], onDelete: SetNull)
  feeders      TournamentBracketMatch[] @relation("BracketAdvancement")
  @@unique([tournamentId, round, position])
}
